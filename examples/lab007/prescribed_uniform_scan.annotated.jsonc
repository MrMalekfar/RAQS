// نسخهٔ آموزشی؛ CLI فقط فایل JSON متناظر را می‌خواند. سایر گزینه‌ها در README.md.
{
  "schema_version": 2,
  "mode": "prescribed",
  "fields": {
    "probe": {
      "wavelength_nm": 780.2414762021273,
      "power_mw": 0.0001,
      "beam_waist_mm": 0.07983624922707379,
      "detuning_mhz": 0.0,
      "polarization": 0
    },
    "coupling": {
      "wavelength_nm": 483.23842408988503,
      "power_mw": 32.0,
      "beam_waist_mm": 0.12230233924147474,
      "detuning_mhz": 0.25,
      "polarization": 0
    },
    "lo": {
      "frequency_hz": 132649000000.0,
      "electric_field_vm": 1.5,
      "polarization": 0
    },
    "signal": {
      "frequency_hz": 132649100000.0,
      "electric_field_vm": 0.005,
      "polarization": 0
    }
  },
  "optical_energy_convention": "fs_centroid",
  "quantization_axis": [
    0.0,
    0.0,
    1.0
  ],
  "ladder": {
    "ground": {
      "n": 5,
      "l": 0,
      "j": 0.5,
      "f": 3,
      "mf": 0
    },
    "excited": {
      "n": 5,
      "l": 1,
      "j": 1.5,
      "f": 4,
      "mf": 0
    },
    "rydberg1": {
      "n": 26,
      "l": 2,
      "j": 2.5,
      "mj": -0.5
    },
    "rydberg2": {
      "n": 27,
      "l": 1,
      "j": 1.5,
      "mj": -0.5
    }
  },
  "execution": {
    "duration_us": 60.0,
    "sample_count": 601,
    "positions_m": [
      [
        0.0,
        0.0,
        0.0
      ],
      [
        0.0002825051753083888,
        0.0,
        0.0
      ],
      [
        0.0005650103506167776,
        0.0,
        0.0
      ]
    ],
    "target_azimuth_deg": -30.0,
    "transient_delay_us": 20.0,
    "sensor_probe_offset_mhz": 0.0,
    "processes": 1,
    // گزینه‌ها: phase_beamforming / bartlett / mvdr / capon / music / esprit / root_music؛ محدودیت هندسه/داده برقرار است.
    "doa_method": "phase_beamforming",
    "cycles_per_snapshot": 2
  },
  "environment": {
    "temperature_k": 300.15,
    "cell_length_m": 0.01,
    "rate_source": "thermal_budget",
    "linewidth_rates_per_us": [
      0.006283185307179587,
      0.006283185307179587,
      0.0
    ],
    "linewidth_enabled": true,
    "collision_enabled": true,
    "transit_enabled": true
  },
  "spectrum": {
    // شبکهٔ یکنواخت واقعی حل؛ به‌جای probe_offsets_mhz، نه همراه آن.
    "probe_scan": {
      // ابتدای offset پروب [MHz]، شامل نقطهٔ ابتدا.
      "start_offset_mhz": -20.0,
      // انتهای offset پروب [MHz]؛ باید بزرگ‌تر از ابتدا باشد، شامل نقطهٔ انتها.
      "stop_offset_mhz": 20.0,
      // تعداد نقاط حل واقعی، عدد صحیح >=2؛ ۲۰۱ تضمین همگرایی نیست. افزایش تعداد هزینهٔ محاسبه را زیاد می‌کند.
      "point_count": 201
    },
    // true/false؛ Doppler در طیف حالت پایا، نه ensemble تحول زمانی.
    "doppler_enabled": true,
    // روش سرعت: adaptive / gauss_hermite / uniform.
    "method": "adaptive",
    "n_classes": 31,
    "n_sigma": 5.0,
    "rtol": 0.0001,
    "atol": 1e-09,
    "counter_propagating": true,
    // true/false؛ تقریب مقایسه‌ای بدون Doppler و transit کامل.
    "analytical_enabled": true
  }
}
